{
  "format": "owl-rules/1",
  "description": "Owl Academy's Firestore requests for the registrar, minor tomes and seals, and the Biomesh collections, with the verdict firestore.rules gives each: the requests the client makes (allow; client names the function in scripts/ that makes it) and requests from another account or a signed-out visitor (deny). The steps run in this order against one emulator database, starting empty. Methods: setDocument, updateDocument and addToCollection are the helpers of scripts/firebase/firestore.js (setDocument merges and adds updatedAt, updateDocument adds updatedAt, addToCollection adds createdAt; here it takes a document path, an addDoc with a known id); get, list and delete are plain reads and deletes. Run by tests/rules/rules.test.mjs, checked offline by tests/unit/rules-requests.test.mjs.",
  "accounts": {"A":"a member who grows, publishes and sends a chain","B":"a member who receives it","C":"another member"},
  "groups": [
    {
      "id": "registrar",
      "title": "Registrar (users/{uid}/registrar/main): forged once by its owner, readable by its owner",
      "steps": [
        { "id": "reg-forge-a", "name": "A forges a registrar", "as": "A", "expect": "allow", "method": "setDocument", "path": "users/A/registrar/main", "client": "scripts/spire-registrar.js writeRegistrar", "data": {"ledgerSeed":"seed a","cosmologicalId":"0xA1","geoVector":"geo-a","coords":[0.1,0.2,0.3],"entropy":0.5,"latticeSpace":"E8","registeredAt":"2026-01-01T00:00:00.000Z","sealed":true} },
        { "id": "reg-forge-b", "name": "B forges a registrar", "as": "B", "expect": "allow", "method": "setDocument", "path": "users/B/registrar/main", "client": "scripts/spire-registrar.js writeRegistrar", "data": {"ledgerSeed":"seed b","cosmologicalId":"0xB1","geoVector":"geo-b","coords":[0.1,0.2,0.3],"entropy":0.5,"latticeSpace":"E8","registeredAt":"2026-01-01T00:00:00.000Z","sealed":true} },
        { "id": "reg-read-own", "name": "A reads their registrar", "as": "A", "expect": "allow", "method": "get", "path": "users/A/registrar/main", "client": "scripts/spire-registrar.js readRegistrar" },
        { "id": "reg-read-other", "name": "another member cannot read it", "as": "C", "expect": "deny", "method": "get", "path": "users/A/registrar/main" },
        { "id": "reg-read-signed-out", "name": "a signed-out visitor cannot read it", "as": null, "expect": "deny", "method": "get", "path": "users/A/registrar/main" },
        { "id": "reg-write-other", "name": "another member cannot write it", "as": "C", "expect": "deny", "method": "setDocument", "path": "users/A/registrar/main", "data": {"ledgerSeed":"seed c","cosmologicalId":"0xC1","geoVector":"geo-c","coords":[0.1,0.2,0.3],"entropy":0.5,"latticeSpace":"E8","registeredAt":"2026-01-01T00:00:00.000Z","sealed":true} },
        { "id": "reg-forge-again", "name": "A cannot forge it again with a new seed", "as": "A", "expect": "deny", "method": "setDocument", "path": "users/A/registrar/main", "data": {"ledgerSeed":"seed z","cosmologicalId":"0xA9","geoVector":"geo-z","coords":[0.1,0.2,0.3],"entropy":0.5,"latticeSpace":"E8","registeredAt":"2026-01-01T00:00:00.000Z","sealed":true} },
        { "id": "reg-change-seed", "name": "the ledger seed cannot change", "as": "A", "expect": "deny", "method": "updateDocument", "path": "users/A/registrar/main", "data": {"ledgerSeed":"seed z"} },
        { "id": "reg-change-id", "name": "the Cosmological ID cannot change", "as": "A", "expect": "deny", "method": "updateDocument", "path": "users/A/registrar/main", "data": {"cosmologicalId":"0xA9"} },
        { "id": "reg-change-geo", "name": "the geo vector cannot change", "as": "A", "expect": "deny", "method": "updateDocument", "path": "users/A/registrar/main", "data": {"geoVector":"geo-z"} },
        { "id": "reg-delete", "name": "a registrar cannot be deleted", "as": "A", "expect": "deny", "method": "delete", "path": "users/A/registrar/main" }
      ]
    },
    {
      "id": "seals",
      "title": "Minor tomes (users/{uid}/minorTomes, owner only) and the public seal registry (seals)",
      "steps": [
        { "id": "tome-mint", "name": "A mints a minor tome (private document)", "as": "A", "expect": "allow", "method": "setDocument", "path": "users/A/minorTomes/K1", "client": "scripts/minor-tome.js mintMinorTome", "data": {"sealId":"K1","label":"Minor Tome","params":{},"sealVector":"sv-K1","coords":[0.1,0.2,0.3],"entropy":0.4,"tickToken":"TICK.1","tick":{"token":"TICK.1","beat":1},"genesisId":"0xA1","ownerUid":"A","tier":"ACOLYTE","priority":1,"status":"active","createdAt":"2026-01-01T00:00:00.000Z","publicJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y"},"privateJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y","d":"test-d"}} },
        { "id": "seal-register", "name": "A registers its public seal", "as": "A", "expect": "allow", "method": "setDocument", "path": "seals/K1", "client": "scripts/minor-tome.js mintMinorTome", "data": {"sealId":"K1","ownerUid":"A","genesisId":"0xA1","tier":"ACOLYTE","sealVector":"sv-K1","coords":[0.1,0.2,0.3],"params":{},"tickToken":"TICK.1","tick":{"token":"TICK.1","beat":1},"publicJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y"},"status":"active","label":"Minor Tome","createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "chron-tome-mint", "name": "A records the mint in the chronicle", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E01", "client": "scripts/minor-tome.js mintMinorTome", "data": {"kind":"minor-tome.mint","uid":"A","sealId":"K1","genesisId":"0xA1","tickToken":"TICK.1"} },
        { "id": "tome-list-own", "name": "A lists their minor tomes", "as": "A", "expect": "allow", "method": "list", "path": "users/A/minorTomes", "client": "scripts/minor-tome.js listMinorTomes" },
        { "id": "tome-read-own", "name": "A reads their minor tome to sign", "as": "A", "expect": "allow", "method": "get", "path": "users/A/minorTomes/K1", "client": "scripts/minor-tome.js signWithMinorTome" },
        { "id": "tome-read-other", "name": "another member cannot read it", "as": "C", "expect": "deny", "method": "get", "path": "users/A/minorTomes/K1" },
        { "id": "tome-list-other", "name": "another member cannot list A's minor tomes", "as": "C", "expect": "deny", "method": "list", "path": "users/A/minorTomes" },
        { "id": "tome-read-signed-out", "name": "a signed-out visitor cannot read it", "as": null, "expect": "deny", "method": "get", "path": "users/A/minorTomes/K1" },
        { "id": "tome-write-other", "name": "another member cannot write into A's minor tomes", "as": "C", "expect": "deny", "method": "setDocument", "path": "users/A/minorTomes/K9", "data": {"sealId":"K9","label":"Minor Tome","params":{},"sealVector":"sv-K9","coords":[0.1,0.2,0.3],"entropy":0.4,"tickToken":"TICK.1","tick":{"token":"TICK.1","beat":1},"genesisId":"0xA1","ownerUid":"A","tier":"ACOLYTE","priority":1,"status":"active","createdAt":"2026-01-01T00:00:00.000Z","publicJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y"},"privateJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y","d":"test-d"}} },
        { "id": "seal-read", "name": "any member reads a public seal to verify", "as": "C", "expect": "allow", "method": "get", "path": "seals/K1", "client": "scripts/minor-tome.js verifySealBlock" },
        { "id": "seal-read-signed-out", "name": "a signed-out visitor cannot read seals", "as": null, "expect": "deny", "method": "get", "path": "seals/K1" },
        { "id": "seal-register-for-other", "name": "a seal cannot be registered for another member", "as": "C", "expect": "deny", "method": "setDocument", "path": "seals/K9", "data": {"sealId":"K9","ownerUid":"A","genesisId":"0xA1","tier":"ACOLYTE","sealVector":"sv-K9","coords":[0.1,0.2,0.3],"params":{},"tickToken":"TICK.1","tick":{"token":"TICK.1","beat":1},"publicJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y"},"status":"active","label":"Minor Tome","createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "seal-status-other", "name": "another member cannot change a seal's status", "as": "C", "expect": "deny", "method": "updateDocument", "path": "seals/K1", "data": {"status":"recalled","recalledTick":"TICK.2"} },
        { "id": "seal-change-key", "name": "a seal's public key cannot change", "as": "A", "expect": "deny", "method": "updateDocument", "path": "seals/K1", "data": {"publicJwk":{"kty":"EC","crv":"P-256","x":"other-x","y":"test-y"}} },
        { "id": "seal-delete", "name": "a seal cannot be deleted", "as": "A", "expect": "deny", "method": "delete", "path": "seals/K1" },
        { "id": "tome-mint-2", "name": "A mints a second minor tome", "as": "A", "expect": "allow", "method": "setDocument", "path": "users/A/minorTomes/K2", "client": "scripts/minor-tome.js mintMinorTome", "data": {"sealId":"K2","label":"Minor Tome","params":{},"sealVector":"sv-K2","coords":[0.1,0.2,0.3],"entropy":0.4,"tickToken":"TICK.1","tick":{"token":"TICK.1","beat":1},"genesisId":"0xA1","ownerUid":"A","tier":"ACOLYTE","priority":1,"status":"active","createdAt":"2026-01-01T00:00:00.000Z","publicJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y"},"privateJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y","d":"test-d"}} },
        { "id": "seal-register-2", "name": "A registers its public seal", "as": "A", "expect": "allow", "method": "setDocument", "path": "seals/K2", "client": "scripts/minor-tome.js mintMinorTome", "data": {"sealId":"K2","ownerUid":"A","genesisId":"0xA1","tier":"ACOLYTE","sealVector":"sv-K2","coords":[0.1,0.2,0.3],"params":{},"tickToken":"TICK.1","tick":{"token":"TICK.1","beat":1},"publicJwk":{"kty":"EC","crv":"P-256","x":"test-x","y":"test-y"},"status":"active","label":"Minor Tome","createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "tome-recall", "name": "A recalls it (private document)", "as": "A", "expect": "allow", "method": "updateDocument", "path": "users/A/minorTomes/K2", "client": "scripts/minor-tome.js setStatus", "data": {"status":"recalled"} },
        { "id": "seal-recall", "name": "A recalls it (public seal)", "as": "A", "expect": "allow", "method": "updateDocument", "path": "seals/K2", "client": "scripts/minor-tome.js setStatus", "data": {"status":"recalled","recalledTick":"TICK.2"} },
        { "id": "chron-tome-recall", "name": "A records the recall in the chronicle", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E02", "client": "scripts/minor-tome.js setStatus", "data": {"kind":"minor-tome.recalled","uid":"A","sealId":"K2","tickToken":"TICK.2"} }
      ]
    },
    {
      "id": "chains",
      "title": "Biochains (biochains): published by their grower, listed and paired by their owner, never deleted",
      "steps": [
        { "id": "chain-publish", "name": "A publishes a grown chain", "as": "A", "expect": "allow", "method": "setDocument", "path": "biochains/C1", "client": "scripts/biomesh.js publishBiochain", "data": {"chainId":"C1","merkleRoot":"root-C1","title":"Untitled Biochain","description":"","growerUid":"A","growerGenesisId":"0xA1","growerSealId":"K1","grownSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"grown-C1","signature":"test-signature","tickToken":"TICK.1"},"ownerUid":"A","ownerGenesisId":"0xA1","lineage":[{"event":"grown","uid":"A","genesisId":"0xA1","tick":"TICK.1","at":"2026-01-01T00:00:00.000Z"}],"lastTransferId":null,"status":"grown","tickToken":"TICK.1","createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "chron-grown", "name": "A records it in the chronicle", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E03", "client": "scripts/biomesh.js publishBiochain", "data": {"kind":"biomesh.grown","uid":"A","chainId":"C1","genesisId":"0xA1","sealId":"K1","merkleRoot":"root-C1","tickToken":"TICK.1"} },
        { "id": "chain-publish-epoch", "name": "A publishes a growth epoch of it", "as": "A", "expect": "allow", "method": "setDocument", "path": "biochains/C2", "client": "scripts/biomesh.js publishBiochain", "data": {"chainId":"C2","merkleRoot":"root-C2","parentChainId":"C1","epoch":1,"growthSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"growth-C2","signature":"test-signature","tickToken":"TICK.1"},"title":"Untitled Biochain","description":"","growerUid":"A","growerGenesisId":"0xA1","growerSealId":"K1","grownSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"grown-C2","signature":"test-signature","tickToken":"TICK.1"},"ownerUid":"A","ownerGenesisId":"0xA1","lineage":[{"event":"grown","uid":"A","genesisId":"0xA1","tick":"TICK.1","at":"2026-01-01T00:00:00.000Z"}],"lastTransferId":null,"status":"grown","tickToken":"TICK.1","createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "chron-extended", "name": "A records the epoch in the chronicle", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E04", "client": "scripts/biomesh.js publishBiochain", "data": {"kind":"biomesh.extended","uid":"A","chainId":"C2","genesisId":"0xA1","sealId":"K1","merkleRoot":"root-C2","tickToken":"TICK.1","parentChainId":"C1","epoch":1} },
        { "id": "chain-read", "name": "any member reads a chain", "as": "C", "expect": "allow", "method": "get", "path": "biochains/C1", "client": "scripts/biomesh.js getBiochain" },
        { "id": "chain-list", "name": "any member lists chains", "as": "C", "expect": "allow", "method": "list", "path": "biochains", "client": "scripts/biomesh.js listBiochains" },
        { "id": "chain-read-signed-out", "name": "a signed-out visitor cannot read chains", "as": null, "expect": "deny", "method": "get", "path": "biochains/C1" },
        { "id": "chain-publish-signed-out", "name": "a signed-out visitor cannot publish", "as": null, "expect": "deny", "method": "setDocument", "path": "biochains/C9", "data": {"chainId":"C9","merkleRoot":"root-C9","title":"Untitled Biochain","description":"","growerUid":"A","growerGenesisId":"0xA1","growerSealId":"K1","grownSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"grown-C9","signature":"test-signature","tickToken":"TICK.1"},"ownerUid":"A","ownerGenesisId":"0xA1","lineage":[{"event":"grown","uid":"A","genesisId":"0xA1","tick":"TICK.1","at":"2026-01-01T00:00:00.000Z"}],"lastTransferId":null,"status":"grown","tickToken":"TICK.1","createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "chain-publish-for-other", "name": "a member cannot publish a chain naming another grower and owner", "as": "C", "expect": "deny", "method": "setDocument", "path": "biochains/C9", "data": {"chainId":"C9","merkleRoot":"root-C9","title":"Untitled Biochain","description":"","growerUid":"A","growerGenesisId":"0xA1","growerSealId":"K1","grownSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"grown-C9","signature":"test-signature","tickToken":"TICK.1"},"ownerUid":"A","ownerGenesisId":"0xA1","lineage":[{"event":"grown","uid":"A","genesisId":"0xA1","tick":"TICK.1","at":"2026-01-01T00:00:00.000Z"}],"lastTransferId":null,"status":"grown","tickToken":"TICK.1","createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "chain-listing", "name": "A lists the chain on the marketplace", "as": "A", "expect": "allow", "method": "updateDocument", "path": "biochains/C1", "client": "scripts/biomesh.js setListing", "data": {"status":"listed"} },
        { "id": "chron-listing", "name": "A records the listing in the chronicle", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E05", "client": "scripts/biomesh.js setListing", "data": {"kind":"biomesh.listing","uid":"A","chainId":"C1","listed":true} },
        { "id": "chain-listing-other", "name": "another member cannot change the listing", "as": "C", "expect": "deny", "method": "updateDocument", "path": "biochains/C1", "data": {"status":"grown"} },
        { "id": "chain-edit-record", "name": "the grown record cannot change", "as": "A", "expect": "deny", "method": "updateDocument", "path": "biochains/C1", "data": {"merkleRoot":"root-other"} },
        { "id": "chain-delete", "name": "a chain cannot be deleted", "as": "A", "expect": "deny", "method": "delete", "path": "biochains/C1" }
      ]
    },
    {
      "id": "codices",
      "title": "Codices (biomeshCodices): published once by their creator, paired on the chain by its owner",
      "steps": [
        { "id": "codex-publish", "name": "A publishes a codex", "as": "A", "expect": "allow", "method": "setDocument", "path": "biomeshCodices/X1", "client": "scripts/biomesh.js publishCodex", "data": {"codexHash":"X1","entryCount":3,"stream":"CODEX/1 test stream","title":"Untitled Codex","derivedFromChainId":"C1","creatorUid":"A","creatorGenesisId":"0xA1","creatorSealId":"K1","codexSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"codex-X1","signature":"test-signature","tickToken":"TICK.1"},"createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "chron-codex", "name": "A records it in the chronicle", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E06", "client": "scripts/biomesh.js publishCodex", "data": {"kind":"biomesh.codex","uid":"A","codexHash":"X1","genesisId":"0xA1","entryCount":3} },
        { "id": "codex-read", "name": "any member reads a codex", "as": "C", "expect": "allow", "method": "get", "path": "biomeshCodices/X1", "client": "scripts/biomesh.js getCodex" },
        { "id": "codex-read-signed-out", "name": "a signed-out visitor cannot read codices", "as": null, "expect": "deny", "method": "get", "path": "biomeshCodices/X1" },
        { "id": "codex-publish-for-other", "name": "a member cannot publish a codex naming another creator", "as": "C", "expect": "deny", "method": "setDocument", "path": "biomeshCodices/X9", "data": {"codexHash":"X9","entryCount":3,"stream":"CODEX/1 test stream","title":"Untitled Codex","derivedFromChainId":"C1","creatorUid":"A","creatorGenesisId":"0xA1","creatorSealId":"K1","codexSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"codex-X9","signature":"test-signature","tickToken":"TICK.1"},"createdAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "codex-edit", "name": "a codex cannot change", "as": "A", "expect": "deny", "method": "updateDocument", "path": "biomeshCodices/X1", "data": {"title":"Renamed"} },
        { "id": "codex-delete", "name": "a codex cannot be deleted", "as": "A", "expect": "deny", "method": "delete", "path": "biomeshCodices/X1" },
        { "id": "chain-pair", "name": "A pairs the codex to the chain", "as": "A", "expect": "allow", "method": "updateDocument", "path": "biochains/C1", "client": "scripts/biomesh.js pairCodex", "data": {"pairedCodexHash":"X1","pairSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"pair-C1-X1","signature":"test-signature","tickToken":"TICK.1"}} },
        { "id": "chron-paired", "name": "A records the pairing in the chronicle", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E07", "client": "scripts/biomesh.js pairCodex", "data": {"kind":"biomesh.paired","uid":"A","chainId":"C1","codexHash":"X1"} },
        { "id": "chain-pair-other", "name": "another member cannot pair a codex to A's chain", "as": "C", "expect": "deny", "method": "updateDocument", "path": "biochains/C1", "data": {"pairedCodexHash":"X1","pairSeal":{"sealId":"K9","genesisId":"0xA1","contentHash":"pair-C1-X1","signature":"test-signature","tickToken":"TICK.1"}} }
      ]
    },
    {
      "id": "transfers",
      "title": "Transfers (biochainTransfers): free, sent by the owner, resolved once by the recipient",
      "steps": [
        { "id": "xfer-send", "name": "A sends the chain to B", "as": "A", "expect": "allow", "method": "addToCollection", "path": "biochainTransfers/T1", "client": "scripts/biomesh.js sendBiochain", "data": {"chainId":"C1","fromUid":"A","fromGenesisId":"0xA1","toUid":"B","payload":"BIOMESH-XFER/1|C1|0xA1|B|TICK.2","xferSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"xfer","signature":"test-signature","tickToken":"TICK.1"},"price":0,"status":"pending","tickToken":"TICK.2","sentAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "chron-sent", "name": "A records it in the chronicle", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E08", "client": "scripts/biomesh.js sendBiochain", "data": {"kind":"biomesh.sent","uid":"A","chainId":"C1","toUid":"B","transferId":"T1"} },
        { "id": "xfer-send-priced", "name": "a transfer with a price is refused", "as": "A", "expect": "deny", "method": "addToCollection", "path": "biochainTransfers/T9", "data": {"chainId":"C1","fromUid":"A","fromGenesisId":"0xA1","toUid":"B","payload":"BIOMESH-XFER/1|C1|0xA1|B|TICK.2","xferSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"xfer","signature":"test-signature","tickToken":"TICK.1"},"price":5,"status":"pending","tickToken":"TICK.2","sentAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "xfer-send-not-owner", "name": "a member cannot send a chain they do not own", "as": "C", "expect": "deny", "method": "addToCollection", "path": "biochainTransfers/T9", "data": {"chainId":"C1","fromUid":"C","fromGenesisId":"0xB1","toUid":"B","payload":"BIOMESH-XFER/1|C1|0xA1|B|TICK.2","xferSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"xfer","signature":"test-signature","tickToken":"TICK.1"},"price":0,"status":"pending","tickToken":"TICK.2","sentAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "xfer-send-signed-out", "name": "a signed-out visitor cannot send", "as": null, "expect": "deny", "method": "addToCollection", "path": "biochainTransfers/T9", "data": {"chainId":"C1","fromUid":"A","fromGenesisId":"0xA1","toUid":"B","payload":"BIOMESH-XFER/1|C1|0xA1|B|TICK.2","xferSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"xfer","signature":"test-signature","tickToken":"TICK.1"},"price":0,"status":"pending","tickToken":"TICK.2","sentAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "xfer-read", "name": "B reads the transfer", "as": "B", "expect": "allow", "method": "get", "path": "biochainTransfers/T1", "client": "scripts/biomesh.js acceptBiochain" },
        { "id": "xfer-list", "name": "B lists transfers", "as": "B", "expect": "allow", "method": "list", "path": "biochainTransfers", "client": "scripts/biomesh.js listIncoming" },
        { "id": "xfer-accept-not-recipient", "name": "a member other than the recipient cannot accept", "as": "C", "expect": "deny", "method": "updateDocument", "path": "biochainTransfers/T1", "data": {"status":"accepted","acceptedAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "claim-before-accept", "name": "B cannot take the chain before accepting", "as": "B", "expect": "deny", "method": "updateDocument", "path": "biochains/C1", "data": {"ownerUid":"B","ownerGenesisId":"0xB1","lastTransferId":"T1","lineage":[{"event":"grown","uid":"A","genesisId":"0xA1","tick":"TICK.1","at":"2026-01-01T00:00:00.000Z"},{"event":"transfer","transferId":"T1","fromUid":"A","fromGenesisId":"0xA1","toUid":"B","toGenesisId":"0xB1","tick":"TICK.2","at":"2026-01-01T00:00:00.000Z"}]} },
        { "id": "xfer-accept", "name": "B accepts the transfer", "as": "B", "expect": "allow", "method": "updateDocument", "path": "biochainTransfers/T1", "client": "scripts/biomesh.js acceptBiochain", "data": {"status":"accepted","acceptedAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "claim", "name": "B takes ownership through the accepted transfer", "as": "B", "expect": "allow", "method": "updateDocument", "path": "biochains/C1", "client": "scripts/biomesh.js acceptBiochain", "data": {"ownerUid":"B","ownerGenesisId":"0xB1","lastTransferId":"T1","lineage":[{"event":"grown","uid":"A","genesisId":"0xA1","tick":"TICK.1","at":"2026-01-01T00:00:00.000Z"},{"event":"transfer","transferId":"T1","fromUid":"A","fromGenesisId":"0xA1","toUid":"B","toGenesisId":"0xB1","tick":"TICK.2","at":"2026-01-01T00:00:00.000Z"}]} },
        { "id": "chron-accepted", "name": "B records it in the chronicle", "as": "B", "expect": "allow", "method": "addToCollection", "path": "chronicles/E09", "client": "scripts/biomesh.js acceptBiochain", "data": {"kind":"biomesh.accepted","uid":"B","chainId":"C1","transferId":"T1"} },
        { "id": "xfer-accept-again", "name": "an accepted transfer cannot be accepted again", "as": "B", "expect": "deny", "method": "updateDocument", "path": "biochainTransfers/T1", "data": {"status":"accepted","acceptedAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "xfer-decline-after-accept", "name": "an accepted transfer cannot be declined", "as": "B", "expect": "deny", "method": "updateDocument", "path": "biochainTransfers/T1", "data": {"status":"declined"} },
        { "id": "former-owner-listing", "name": "A, no longer the owner, cannot change the listing", "as": "A", "expect": "deny", "method": "updateDocument", "path": "biochains/C1", "data": {"status":"grown"} },
        { "id": "former-owner-send", "name": "A, no longer the owner, cannot send the chain", "as": "A", "expect": "deny", "method": "addToCollection", "path": "biochainTransfers/T9", "data": {"chainId":"C1","fromUid":"A","fromGenesisId":"0xA1","toUid":"C","payload":"BIOMESH-XFER/1|C1|0xA1|C|TICK.2","xferSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"xfer","signature":"test-signature","tickToken":"TICK.1"},"price":0,"status":"pending","tickToken":"TICK.2","sentAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "xfer-send-onward", "name": "B sends the chain to C", "as": "B", "expect": "allow", "method": "addToCollection", "path": "biochainTransfers/T2", "client": "scripts/biomesh.js sendBiochain", "data": {"chainId":"C1","fromUid":"B","fromGenesisId":"0xB1","toUid":"C","payload":"BIOMESH-XFER/1|C1|0xA1|C|TICK.2","xferSeal":{"sealId":"K1","genesisId":"0xA1","contentHash":"xfer","signature":"test-signature","tickToken":"TICK.1"},"price":0,"status":"pending","tickToken":"TICK.2","sentAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "xfer-decline", "name": "C declines it", "as": "C", "expect": "allow", "method": "updateDocument", "path": "biochainTransfers/T2", "client": "scripts/biomesh.js declineBiochain", "data": {"status":"declined"} },
        { "id": "chron-declined", "name": "C records it in the chronicle", "as": "C", "expect": "allow", "method": "addToCollection", "path": "chronicles/E10", "client": "scripts/biomesh.js declineBiochain", "data": {"kind":"biomesh.declined","uid":"C","transferId":"T2"} },
        { "id": "claim-declined", "name": "C cannot take the chain through a declined transfer", "as": "C", "expect": "deny", "method": "updateDocument", "path": "biochains/C1", "data": {"ownerUid":"C","ownerGenesisId":null,"lastTransferId":"T2","lineage":[{"event":"grown","uid":"A","genesisId":"0xA1","tick":"TICK.1","at":"2026-01-01T00:00:00.000Z"},{"event":"transfer","transferId":"T2","fromUid":"B","fromGenesisId":"0xA1","toUid":"C","toGenesisId":null,"tick":"TICK.2","at":"2026-01-01T00:00:00.000Z"}]} },
        { "id": "xfer-delete", "name": "a transfer cannot be deleted", "as": "B", "expect": "deny", "method": "delete", "path": "biochainTransfers/T1" }
      ]
    },
    {
      "id": "ratings",
      "title": "Ratings (biochainRatings): one per member and chain, under {chainId}_{uid}, edited only by the rater",
      "steps": [
        { "id": "rate", "name": "C rates the chain", "as": "C", "expect": "allow", "method": "setDocument", "path": "biochainRatings/C1_C", "client": "scripts/biomesh.js rateBiochain", "data": {"chainId":"C1","raterUid":"C","raterGenesisId":null,"raterTier":"ACOLYTE","stars":4,"comment":"","recreatedOk":true,"ratedAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "chron-rated", "name": "C records it in the chronicle", "as": "C", "expect": "allow", "method": "addToCollection", "path": "chronicles/E11", "client": "scripts/biomesh.js rateBiochain", "data": {"kind":"biomesh.rated","uid":"C","chainId":"C1","stars":4} },
        { "id": "rate-again", "name": "C rates it again", "as": "C", "expect": "allow", "method": "setDocument", "path": "biochainRatings/C1_C", "client": "scripts/biomesh.js rateBiochain", "data": {"chainId":"C1","raterUid":"C","raterGenesisId":null,"raterTier":"ACOLYTE","stars":5,"comment":"","recreatedOk":true,"ratedAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "rate-list", "name": "any member lists ratings", "as": "A", "expect": "allow", "method": "list", "path": "biochainRatings", "client": "scripts/biomesh.js listRatings" },
        { "id": "rate-for-other", "name": "a member cannot rate in another member's name", "as": "C", "expect": "deny", "method": "setDocument", "path": "biochainRatings/C1_B", "data": {"chainId":"C1","raterUid":"B","raterGenesisId":null,"raterTier":"ACOLYTE","stars":1,"comment":"","recreatedOk":true,"ratedAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "rate-wrong-id", "name": "a rating must sit under {chainId}_{own uid}", "as": "C", "expect": "deny", "method": "setDocument", "path": "biochainRatings/C1_B", "data": {"chainId":"C1","raterUid":"C","raterGenesisId":null,"raterTier":"ACOLYTE","stars":1,"comment":"","recreatedOk":true,"ratedAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "rate-edit-other", "name": "another member cannot edit C's rating", "as": "B", "expect": "deny", "method": "updateDocument", "path": "biochainRatings/C1_C", "data": {"stars":1} },
        { "id": "rate-signed-out", "name": "a signed-out visitor cannot rate", "as": null, "expect": "deny", "method": "setDocument", "path": "biochainRatings/C1_X", "data": {"chainId":"C1","raterUid":"X","raterGenesisId":null,"raterTier":"ACOLYTE","stars":1,"comment":"","recreatedOk":true,"ratedAt":"2026-01-01T00:00:00.000Z"} },
        { "id": "rate-delete", "name": "a rating cannot be deleted", "as": "C", "expect": "deny", "method": "delete", "path": "biochainRatings/C1_C" }
      ]
    },
    {
      "id": "chronicles",
      "title": "Chronicle (chronicles): appended by signed-in members, read server-side only",
      "steps": [
        { "id": "chron-session-burned", "name": "A records a burned session", "as": "A", "expect": "allow", "method": "addToCollection", "path": "chronicles/E12", "client": "scripts/biomesh.js logSessionBurn", "data": {"kind":"biomesh.session_burned","uid":"A","turnCount":3,"parityHex":"0F","at":"2026-01-01T00:00:00.000Z"} },
        { "id": "chron-signed-out", "name": "a signed-out visitor cannot append", "as": null, "expect": "deny", "method": "addToCollection", "path": "chronicles/E99", "data": {"kind":"biomesh.grown"} },
        { "id": "chron-rewrite", "name": "an entry cannot be rewritten", "as": "A", "expect": "deny", "method": "updateDocument", "path": "chronicles/E03", "data": {"merkleRoot":"root-other"} },
        { "id": "chron-read", "name": "entries cannot be read from the client", "as": "A", "expect": "deny", "method": "get", "path": "chronicles/E03" }
      ]
    }
  ]
